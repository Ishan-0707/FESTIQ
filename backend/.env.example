# FESTIQ Backend Environment Configuration

# Server Port
PORT=5000

# Security & Authentication
JWT_SECRET=festiq_production_jwt_secret_key_change_in_production_2026
PASS_SECRET_SALT=festiq_pass_qr_cryptographic_salt_token_2026

# Payment Gateway Configuration (Razorpay)
# Set PAYMENT_MODE to 'live', 'test', or 'simulation'
# When PAYMENT_MODE is 'simulation' or keys are omitted, FESTIQ runs an end-to-end
# simulation mode with standard Razorpay order schema and cryptographic HMAC-SHA256 verification.
PAYMENT_MODE=simulation

# Razorpay API Credentials (from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_FESTIQ2026LiveKey
RAZORPAY_KEY_SECRET=festiq_test_secret_key_hmac_2026
RAZORPAY_WEBHOOK_SECRET=festiq_webhook_secret_hmac_2026

# Client / CORS Origin
CLIENT_ORIGIN=http://localhost:5173

